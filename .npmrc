# Разрешать peer-зависимости по-настоящему, а не пропускать их.
#
# Это значение по умолчанию у npm, и строка здесь не меняет поведение —
# она защищает от глобального `legacy-peer-deps=true` в ~/.npmrc.
# Такая настройка уже один раз сломала CI: lock-файл собрался с
# проигнорированными peer-зависимостями, `npm ci` на чистой машине честно
# их посчитал, не сошёлся с lock и упал с EUSAGE.
#
# Настройка машины разработчика не должна попадать в общий lock-файл.
legacy-peer-deps=false
